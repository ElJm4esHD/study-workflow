{
  "name": "study-workflow",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "Federico Gaubeca Klix",
  "version": "2.0.0-beta.5",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev:server": "node --watch core/server/main.ts",
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "deploy": "node scripts/deploy.mjs",
    "server-setup": "node scripts/deploy.mjs --setup",
    "apk": "node scripts/apk.mjs",
    "apk:public": "node scripts/apk.mjs --public",
    "audit:apk": "node scripts/audit-apk.mjs",
    "release": "node scripts/release.mjs",
    "a11y": "node -e \"require('fs').rmSync('data/e2e.sqlite',{force:true})\" && vite build && playwright test",
    "capturas": "node -e \"require('fs').rmSync('data/capturas.sqlite',{force:true})\" && vite build && playwright test -c playwright.capturas.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "temporal-polyfill": "^1.0.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@capacitor/haptics": "^8.0.2",
    "@fastify/static": "^10.1.10",
    "fastify": "^5.12.8"
  }
}
