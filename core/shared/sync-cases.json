        { "t": "todo", "id": "b", "data": { "v": 3 }, "hlc": "1650000000000-0000-otro", "dirty": 0 },
        { "t": "todo", "id": "z", "data": { "v": 4 }, "hlc": "1650000000001-0000-otro", "dirty": 0 }
      ],
      "expectCursor": "c3"
    },
    {
      "name": "reset purged: baja todo, descarta lo que el server ya no tiene y conserva lo sucio; el cursor se guarda al final",
      "node": "dev",
      "now": 1700000000000,
      "meta": { "cursor": "viejo" },
      "local": [
        { "t": "todo", "id": "borrada", "data": { "v": 1 }, "hlc": "1600000000000-0000-dev", "dirty": 0 },
        { "t": "todo", "id": "sigue", "data": { "v": 1 }, "hlc": "1600000000000-0000-dev", "dirty": 0 },
        { "t": "todo", "id": "mia", "data": { "v": 1 }, "hlc": "1690000000000-0000-dev", "dirty": 1 }
      ],
      "pages": [
        { "records": [{ "t": "todo", "id": "sigue", "data": { "v": 1 }, "hlc": "1600000000000-0000-dev" }], "cursor": "n1", "more": true, "reset": "purged" },
        { "records": [{ "t": "todo", "id": "mia", "data": { "v": 1 }, "hlc": "1690000000000-0000-dev" }], "cursor": "n2", "more": false }
      ],
      "expectPulls": ["viejo", "n1"],
      "expectPushed": ["todo/mia@1690000000000-0000-dev"],
      "expectRows": [
        { "t": "todo", "id": "mia", "data": { "v": 1 }, "hlc": "1690000000000-0000-dev", "dirty": 0 },
        { "t": "todo", "id": "sigue", "data": { "v": 1 }, "hlc": "1600000000000-0000-dev", "dirty": 0 }
      ],
      "expectCursor": "n2"
    },
    {
      "name": "reset epoch (otro server): no borra nada local, vuelve a subir todo",
      "node": "dev",
      "now": 1700000000000,
      "meta": { "cursor": "viejo" },
      "local": [
        { "t": "todo", "id": "a", "data": { "v": 1 }, "hlc": "1600000000000-0000-dev", "dirty": 0 },
        { "t": "todo", "id": "b", "data": null, "hlc": "1699999999999-0000-dev", "dirty": 0 }
      ],
      "pages": [{ "records": [], "cursor": "nuevo", "more": false, "reset": "epoch" }],
      "expectPulls": ["viejo"],
      "expectPushed": ["todo/a@1600000000000-0000-dev", "todo/b@1699999999999-0000-dev"],
      "expectRows": [
        { "t": "todo", "id": "a", "data": { "v": 1 }, "hlc": "1600000000000-0000-dev", "dirty": 0 },
        { "t": "todo", "id": "b", "data": null, "hlc": "1699999999999-0000-dev", "dirty": 0 }
      ],
      "expectCursor": "nuevo"
    },
    {
      "name": "las marcas de borrado de más de 180 días se limpian una vez subidas (también las que se acaban de subir); las recientes no",
      "node": "dev",
      "now": 1700000000000,
      "meta": {},
      "local": [
        { "t": "todo", "id": "vieja", "data": null, "hlc": "1680000000000-0000-dev", "dirty": 0 },
        { "t": "todo", "id": "reciente", "data": null, "hlc": "1699000000000-0000-dev", "dirty": 0 },
        { "t": "todo", "id": "sucia", "data": null, "hlc": "1680000000001-0000-dev", "dirty": 1 }
      ],
      "pages": [{ "records": [], "cursor": "c", "more": false }],
      "expectPulls": [null],
      "expectPushed": ["todo/sucia@1680000000001-0000-dev"],
      "expectRows": [
        { "t": "todo", "id": "reciente", "data": null, "hlc": "1699000000000-0000-dev", "dirty": 0 }
      ],
      "expectCursor": "c"
    }
  ],
