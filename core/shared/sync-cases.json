{
  "_doc": "Casos compartidos del motor de sincronización: los corren vitest (TypeScript, core/web/sync/cases.test.ts) y JUnit (Kotlin, SyncCasesTest). Si uno cambia la regla, tiene que cambiar acá y pasar en los dos. Los HLC son ms(13)-contador(4 hex)-nodo.",
  "hlc": [
    {
      "name": "tick sube el contador en el mismo ms, no retrocede con el reloj atrás, y recv deja todo por encima",
      "node": "aaa",
      "steps": [
        { "op": "tick", "now": 1000, "expect": "0000000001000-0000-aaa" },
        { "op": "tick", "now": 1000, "expect": "0000000001000-0001-aaa" },
        { "op": "tick", "now": 500, "expect": "0000000001000-0002-aaa" },
        { "op": "tick", "now": 1001, "expect": "0000000001001-0000-aaa" },
        { "op": "recv", "now": 2000, "hlc": "0000000009000-0007-zzz" },
        { "op": "tick", "now": 2000, "expect": "0000000009000-0009-aaa" },
        { "op": "recv", "now": 20000, "hlc": "0000000009000-0001-zzz" },
        { "op": "tick", "now": 20000, "expect": "0000000020000-0001-aaa" }
      ]
    },
    {
      "name": "recv con el mismo ms local y remoto toma el contador mayor + 1",
      "node": "bbb",
      "steps": [
        { "op": "tick", "now": 5000, "expect": "0000000005000-0000-bbb" },
        { "op": "recv", "now": 100, "hlc": "0000000005000-0005-aaa" },
        { "op": "tick", "now": 100, "expect": "0000000005000-0007-bbb" }
      ]
    }
  ],
  "merge": [
    {
      "name": "lo remoto más nuevo pisa lo local aunque esté sin subir; lo viejo se ignora; las marcas de borrado se respetan",
      "local": [
        { "t": "todo", "id": "a", "data": { "v": "local" }, "hlc": "0000000000005-0000-x", "dirty": 1 },
        { "t": "todo", "id": "b", "data": { "v": "local" }, "hlc": "0000000000009-0000-x", "dirty": 1 },
        { "t": "todo", "id": "c", "data": { "v": "local" }, "hlc": "0000000000005-0000-x", "dirty": 0 }
      ],
      "remote": [
        { "t": "todo", "id": "a", "data": { "v": "remoto" }, "hlc": "0000000000006-0000-y" },
        { "t": "todo", "id": "b", "data": { "v": "remoto" }, "hlc": "0000000000008-0000-y" },
        { "t": "todo", "id": "c", "data": null, "hlc": "0000000000006-0000-y" },
        { "t": "todo", "id": "d", "data": { "v": "nuevo" }, "hlc": "0000000000001-0000-y" }
      ],
      "expect": [
        { "t": "todo", "id": "a", "data": { "v": "remoto" }, "hlc": "0000000000006-0000-y", "dirty": 0 },
        { "t": "todo", "id": "b", "data": { "v": "local" }, "hlc": "0000000000009-0000-x", "dirty": 1 },
        { "t": "todo", "id": "c", "data": null, "hlc": "0000000000006-0000-y", "dirty": 0 },
        { "t": "todo", "id": "d", "data": { "v": "nuevo" }, "hlc": "0000000000001-0000-y", "dirty": 0 }
      ],
      "expectChanged": 3
    },
    {
      "name": "mismo ms y contador: desempata el nodo (texto mayor gana)",
      "local": [{ "t": "todo", "id": "a", "data": { "v": "a" }, "hlc": "0000000000005-0000-aaa", "dirty": 0 }],
      "remote": [{ "t": "todo", "id": "a", "data": { "v": "b" }, "hlc": "0000000000005-0000-bbb" }],
      "expect": [{ "t": "todo", "id": "a", "data": { "v": "b" }, "hlc": "0000000000005-0000-bbb", "dirty": 0 }],
      "expectChanged": 1
    }
  ],
  "flow": [
    {
      "name": "sube lo sucio, baja páginas, no se pisa lo local más nuevo y guarda el cursor",
      "node": "dev",
      "now": 1700000000000,
      "meta": { "cursor": "c1" },
      "local": [
        { "t": "todo", "id": "a", "data": { "v": 1 }, "hlc": "1700000000000-0000-dev", "dirty": 1 },
        { "t": "todo", "id": "b", "data": { "v": 2 }, "hlc": "1600000000000-0000-dev", "dirty": 0 }
      ],
      "pages": [
        { "records": [{ "t": "todo", "id": "b", "data": { "v": 3 }, "hlc": "1650000000000-0000-otro" }], "cursor": "c2", "more": true },
        { "records": [{ "t": "todo", "id": "a", "data": { "v": 9 }, "hlc": "1500000000000-0000-otro" }, { "t": "todo", "id": "z", "data": { "v": 4 }, "hlc": "1650000000001-0000-otro" }], "cursor": "c3", "more": false }
      ],
      "expectPulls": ["c1", "c2"],
