# Copiar a .env.deploy (no se commitea). Única fuente del puerto: compose, deploy, health check y setup leen de acá.
DEPLOY_HOST=tu-server.tu-tailnet.ts.net
DEPLOY_USER=tu-usuario
# Puerto local del contenedor en el server (bindeado a 127.0.0.1).
PORT=8110
# Puerto HTTPS de tailscale serve (443 ya lo usa otra app).
HTTPS_PORT=8443
